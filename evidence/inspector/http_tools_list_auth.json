{
  "tools": [
    {
      "name": "list_sites",
      "title": "列出网站",
      "description": "列出已注册的新闻网站、验证状态、频道数量和已采集文章数量。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "title": "list_sitesArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "list_sitesDictOutput"
      }
    },
    {
      "name": "list_channels",
      "title": "列出已验证频道",
      "description": "返回已通过真实样本验证、可采集的新闻频道及来源 URL。site_id 可选；省略时返回所有站点，传 all 也表示全部。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "site_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "站点 ID，例如 xinhua；省略或 all 表示全部",
            "title": "Site Id"
          }
        },
        "title": "list_channelsArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "list_channelsDictOutput"
      }
    },
    {
      "name": "get_latest_news",
      "title": "获取最新新闻",
      "description": "获取本地数据库中的最新新闻。refresh=true 时先真实抓取该频道再查询；每条结果标明 data_status=live 或 cached。省略 site_id 时使用默认站点，site_id=all 可跨站查询。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "description": "频道 ID，例如 politics",
            "minLength": 1,
            "title": "Channel",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "返回条数，1..50",
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "refresh": {
            "default": false,
            "description": "是否在查询前真实访问来源网站更新数据",
            "title": "Refresh",
            "type": "boolean"
          },
          "site_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "站点 ID；省略为默认站点，all 为跨站",
            "title": "Site Id"
          }
        },
        "required": [
          "channel"
        ],
        "title": "get_latest_newsArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "get_latest_newsDictOutput"
      }
    },
    {
      "name": "search_news",
      "title": "检索本地新闻",
      "description": "只在本地 SQLite 已采集文章中进行关键词和日期过滤，不搜索网站全站或全部历史。日期格式 YYYY-MM-DD，按 Asia/Shanghai 本地日界解释。site_id 省略时跨所有站点。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "description": "关键词",
            "minLength": 1,
            "title": "Keyword",
            "type": "string"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "起始日期 YYYY-MM-DD（含）",
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "结束日期 YYYY-MM-DD（含）",
            "title": "End Date"
          },
          "channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "频道 ID；省略表示不限频道",
            "title": "Channel"
          },
          "limit": {
            "default": 10,
            "description": "返回条数，1..50",
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "site_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "站点 ID；省略为全站，all 也表示全部",
            "title": "Site Id"
          }
        },
        "required": [
          "keyword"
        ],
        "title": "search_newsArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "search_newsDictOutput"
      }
    },
    {
      "name": "get_article",
      "title": "实时读取文章",
      "description": "对白名单内的文章 URL 执行实时抓取，校验跳转目标、robots.txt、超时和网络错误，返回标题、时间、正文、来源、抓取时间和状态。非白名单 URL 会在联网前被拒绝。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "description": "文章 URL",
            "minLength": 8,
            "title": "Url",
            "type": "string"
          },
          "site_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "可选站点 ID；省略时按 URL 自动识别",
            "title": "Site Id"
          }
        },
        "required": [
          "url"
        ],
        "title": "get_articleArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "get_articleDictOutput"
      }
    },
    {
      "name": "refresh_news",
      "title": "实时刷新频道",
      "description": "真实访问栏目页与文章页，写入 SQLite 并返回 attempted/discovered/inserted/updated/failed 计数。失败会明确返回错误，不会伪装成功。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "description": "频道 ID",
            "minLength": 1,
            "title": "Channel",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "最多抓取条数，1..50",
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "site_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "站点 ID；省略为默认站点",
            "title": "Site Id"
          }
        },
        "required": [
          "channel"
        ],
        "title": "refresh_newsArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "refresh_newsDictOutput"
      }
    },
    {
      "name": "inspect_site",
      "title": "检测网站候选规则",
      "description": "输入网站或栏目 URL，真实抓取并识别 RSS/Sitemap/HTML 候选、文章链接和正文选择器，输出未经确认的候选 YAML 与证据。结果 validated 永远为 false，必须再用 validate_site 验证；不会自动注册站点。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "description": "网站或栏目 URL",
            "minLength": 8,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "inspect_siteArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "inspect_siteDictOutput"
      }
    },
    {
      "name": "validate_site",
      "title": "验证网站采集规则",
      "description": "对已注册站点执行真实栏目发现和文章正文抽取，只有至少一个频道通过样本验证才会标记为可采集。配置错误不会影响其他站点。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "site_id": {
            "description": "站点 ID",
            "minLength": 1,
            "title": "Site Id",
            "type": "string"
          }
        },
        "required": [
          "site_id"
        ],
        "title": "validate_siteArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "validate_siteDictOutput"
      }
    }
  ]
}
